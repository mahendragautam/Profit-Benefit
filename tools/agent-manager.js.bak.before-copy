#!/usr/bin/env node
const fs = require('fs');
const path = require('path');

const repoRoot = process.cwd();
const agentsDir = path.join(repoRoot, '.github', 'agents');
const topicsDir = path.join(agentsDir, 'topics');
const activePath = path.join(agentsDir, 'active.json');

function safeReadActive() {
  try {
    if (!fs.existsSync(activePath)) return [];
    const j = JSON.parse(fs.readFileSync(activePath, 'utf8'));
    if (Array.isArray(j)) return j;
    return [];
  } catch (e) {
    return [];
  }
}

function safeWriteActive(arr) {
  fs.writeFileSync(activePath, JSON.stringify(Array.from(new Set(arr)), null, 2), 'utf8');
}

function listAgents() {
  const active = safeReadActive();
  const available = [];
  if (!fs.existsSync(agentsDir)) {
    console.error('No .github/agents directory found');
    process.exit(1);
  }

  // read topics first (if exist)
  const topics = new Set();
  if (fs.existsSync(topicsDir) && fs.statSync(topicsDir).isDirectory()) {
    fs.readdirSync(topicsDir).forEach(f => {
      if (f.toLowerCase().endsWith('.md')) topics.add(path.join('topics', f));
    });
  }

  // top-level agent files
  fs.readdirSync(agentsDir).forEach(f => {
    const full = path.join(agentsDir, f);
    if (fs.statSync(full).isDirectory()) return; // skip directories (topics handled above)
    if (!f.toLowerCase().endsWith('.md')) return;
    available.push(f);
  });

  // include topics files as separate entries (display as topics)
  if (topics.size > 0) {
    topics.forEach(t => {
      available.push(t.replace(/\\/g, '/'));
    });
  }

  console.log('\nAvailable agents:');
  available.sort().forEach(name => {
    const isTopic = name.startsWith('topics/');
    const displayName = name;
    const visiblePart = isTopic ? 'visible (topics' : 'visible [core';
    const relKey = name; // use the name as key to store in active.json
    const activeFlag = active.includes(relKey) || active.includes(displayName) || active.includes(path.basename(name));
    const bracket = activeFlag ? (isTopic ? ': active)' : ' : active]') : (isTopic ? ')' : ']');
    console.log(`- ${displayName} : ${visiblePart}${bracket}`);
  });
  console.log('\n');
}

function activate(name) {
  const active = safeReadActive();
  const key = findAgentKey(name);
  if (!key) {
    console.error('Agent not found:', name);
    process.exit(1);
  }
  if (!active.includes(key)) active.push(key);
  safeWriteActive(active);
  console.log(`Activated ${key}`);
}

function deactivate(name) {
  let active = safeReadActive();
  const key = findAgentKey(name);
  if (!key) {
    console.error('Agent not found:', name);
    process.exit(1);
  }
  active = active.filter(x => x !== key && x !== path.basename(key) && x !== key.replace('topics/',''));
  safeWriteActive(active);
  console.log(`Deactivated ${key}`);
}

function findAgentKey(name) {
  // Accept exact filename, basename, or topics/<file>
  const candidates = [];
  if (fs.existsSync(agentsDir)) {
    fs.readdirSync(agentsDir).forEach(f => {
      if (f.toLowerCase().endsWith('.md')) candidates.push(f);
    });
  }
  if (fs.existsSync(topicsDir)) {
    fs.readdirSync(topicsDir).forEach(f => {
      if (f.toLowerCase().endsWith('.md')) candidates.push(path.posix.join('topics', f));
    });
  }
  // exact match
  if (candidates.includes(name)) return name;
  // topics/<name>.md
  if (name.endsWith('.md')) {
    const base = name;
    const t = candidates.find(c => c === base || path.posix.basename(c) === base);
    if (t) return t;
  }
  // try basename
  const byBase = candidates.find(c => path.posix.basename(c) === name || path.posix.basename(c) === (name + '.md'));
  if (byBase) return byBase;
  return null;
}

function usage() {
  console.log('Usage: node tools/agent-manager.js <command> [agent]');
  console.log('Commands:');
  console.log('  list                     List available agents (shows active state)');
  console.log('  activate <agent-file>    Activate an agent (basename or topics/name.md)');
  console.log('  deactivate <agent-file>  Deactivate an agent');
}

const argv = process.argv.slice(2);
if (argv.length === 0) {
  usage();
  process.exit(0);
}

const cmd = argv[0];
if (cmd === 'list') listAgents();
else if (cmd === 'activate') {
  if (!argv[1]) { usage(); process.exit(1); }
  activate(argv[1]);
} else if (cmd === 'deactivate') {
  if (!argv[1]) { usage(); process.exit(1); }
  deactivate(argv[1]);
} else {
  usage();
  process.exit(1);
}

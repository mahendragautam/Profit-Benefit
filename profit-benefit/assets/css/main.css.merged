/* ============================================
   ROOT VARIABLES & RESETS
   ============================================ */
:root {
    /* Brand Colors */
    --primary: #1a2e4a;
    --primary-hover: #152538;
    --primary-light: #2d4a6e;
    --secondary: #2d6a4f;
    --secondary-hover: #246049;
    --accent: #40916c;
    --accent-hover: #52a47c;
    --accent-light: #95d5b2;
    
    /* Neutral Palette */
    --white: #ffffff;
    --light: #f8f9fa;
    --border: #dee2e6;
    --border-hover: #adb5bd;
    --text: #2c3e50;
    --text-light: #495057;
    --muted: #6c757d;
    --gray-100: #f8f9fa;
    --gray-200: #e9ecef;
    --gray-300: #dee2e6;
    --gray-400: #ced4da;
    --gray-600: #6c757d;
    --gray-800: #343a40;
    --gray-900: #212529;
    
    /* Legacy color variables (for backward compatibility) */
    --black: #000;
    --text-muted: #666;
    --text-dark: #333;
    --gray: #8895a7;
    
    /* Semantic Colors */
    --success: #52b788;
    --success-light: #d4edda;
    --warning: #f4a261;
    --warning-light: #fdebd0;
    --error: #e63946;
    --error-light: #fad8d8;
    --info: #457b9d;
    --info-light: #d1e7f0;
    
    /* Gradients */
    --gradient-1: linear-gradient(135deg, #1a2e4a 0%, #2d6a4f 100%);
    --gradient-2: linear-gradient(135deg, #2d6a4f 0%, #40916c 100%);
    --gradient-3: linear-gradient(135deg, #40916c 0%, #52b788 100%);
    --gradient-hero: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    --gradient-hero-bg: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
    --gradient-overlay-dark: linear-gradient(transparent, rgb(0 0 0 / 90%));
    --gradient-overlay-medium: linear-gradient(transparent, rgb(0 0 0 / 85%));
    
    /* Shadows (soft, modern) */
    --shadow-xs: 0 1px 3px rgba(26, 46, 74, 0.08);
    --shadow-sm: 0 4px 12px rgba(26, 46, 74, 0.08);
    --shadow-md: 0 8px 24px rgba(26, 46, 74, 0.12);
    --shadow-lg: 0 16px 32px rgba(26, 46, 74, 0.16);
    --shadow-xl: 0 24px 48px rgba(26, 46, 74, 0.20);
    
    /* Spacing scale (4px grid system) */
    --space-1: 0.25rem; /* 4px */
    --space-2: 0.5rem; /* 8px */
    --space-3: 0.75rem; /* 12px */
    --space-4: 1rem; /* 16px */
    --space-5: 1.5rem; /* 24px */
    --space-6: 2rem; /* 32px */
    --space-8: 3rem; /* 48px */
    --space-10: 4rem; /* 64px */
    --space-12: 5rem; /* 80px */
    
    /* Border Radius */
    --radius-sm: 6px;
    --radius: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 24px;
    --radius-full: 9999px;
    
    /* Typography */
    --font-xs: 0.75rem; /* 12px */
    --font-sm: 0.875rem; /* 14px */
    --font-base: 1rem; /* 16px */
    --font-lg: 1.125rem; /* 18px */
    --font-xl: 1.25rem; /* 20px */
    --font-2xl: 1.5rem; /* 24px */
    --font-3xl: 1.875rem; /* 30px */
    --font-4xl: 2.25rem; /* 36px */
    
    /* Transitions */
    --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-base: 250ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: 400ms cubic-bezier(0.4, 0, 0.2, 1);
    
    /* Z-Index */
    --z-base: 1;
    --z-dropdown: 100;
    --z-sticky: 200;
    --z-fixed: 300;
    --z-modal-backdrop: 400;
    --z-modal: 500;
    --z-tooltip: 600;
    --z-toast: 700;
}

/* ========== Dark Mode (prefers-color-scheme) ========== */
@media (prefers-color-scheme: dark) {
    :root {
        --light: #1e1e1e;
        --border: #333333;
        --border-hover: #4a4a4a;
        --text: #e8e8e8;
        --text-light: #b8b8b8;
        --muted: #888888;
        --gray-100: #2a2a2a;
        --gray-200: #333333;
        --gray-300: #404040;
        --gray-400: #525252;
        --gray-600: #888888;
        --gray-800: #e8e8e8;
        --gray-900: #f5f5f5;
        
        --shadow-xs: 0 1px 3px rgba(0, 0, 0, 0.4);
        --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.5);
        --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.6);
        --shadow-lg: 0 16px 32px rgba(0, 0, 0, 0.7);
        --shadow-xl: 0 24px 48px rgba(0, 0, 0, 0.8);
    }
    
    
    .card,
    input:not([type="checkbox"]):not([type="radio"]),
    textarea,
    select {
        background: var(--light);
    }
}

/* ========== Global Reset & Base ========== */
*,
*::before,
*::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 100%; /* 16px base */
    line-height: 1.5;
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: var(--text);
    line-height: 1.6;
    background: var(--white);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* Media Elements */
img,
picture,
video,
canvas,
svg {
    display: block;
    max-width: 100%;
    height: auto;
}

/* ========== Layout ========== */
.container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--space-4);
}

@media (min-width: 768px) {
    .container {
        padding: 0 var(--space-6);
    }
}

.container-sm { max-width: 640px; }
.container-lg { max-width: 1536px; }
.container-fluid { max-width: 100%; padding: 0 var(--space-4); }

/* ========== Typography ========== */
h1, h2, h3, h4, h5, h6 {
    margin-bottom: var(--space-3);
    font-weight: 600;
    line-height: 1.2;
    color: var(--text);
}

h1 { font-size: clamp(2.5rem, 5vw, 4rem); }
h2 { font-size: clamp(2rem, 4vw, 3rem); }
h3 { font-size: clamp(1.5rem, 3vw, 2.25rem); }
h4 { font-size: var(--font-2xl); }
h5 { font-size: var(--font-xl); }
h6 { font-size: var(--font-lg); }

p {
    margin-bottom: var(--space-4);
    color: var(--text-light);
}

a {
    color: var(--accent);
    text-decoration: none;
    transition: color var(--transition-fast);
}

a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
}

strong { font-weight: 600; }
small, .text-sm { font-size: var(--font-sm); }

/* ========== Buttons ========== */
.btn,
button:not([class*="wp-"]):not([class*="search"]) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5ch;
    padding: 0.65rem 1.25rem;
    font-family: inherit;
    font-size: var(--font-base);
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--white);
    transition: 
        background var(--transition-fast),
        border-color var(--transition-fast),
        transform var(--transition-base),
        box-shadow var(--transition-base);
    user-select: none;
}

.btn:hover,
button:not([class*="wp-"]):not([class*="search"]):hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
}

.btn:active,
button:not([class*="wp-"]):not([class*="search"]):active {
    transform: translateY(0);
    box-shadow: var(--shadow-sm);
}

.btn:disabled,
button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
}

/* Button Variants */
.btn-primary { background: var(--primary); border-color: var(--primary); }
.btn-primary:hover { background: var(--primary-hover); }

.btn-secondary {
    background: transparent;
    color: var(--primary);
    border-color: var(--border);
}

.btn-secondary:hover {
    background: var(--gray-100);
    border-color: var(--border-hover);
}

.btn-outline {
    background: transparent;
    color: var(--accent);
    border-color: var(--accent);
}

.btn-outline:hover {
    background: var(--accent);
    color: var(--white);
}

/* Button Sizes */
.btn-sm { padding: 0.45rem 0.9rem; font-size: var(--font-sm); }
.btn-lg { padding: 0.85rem 1.75rem; font-size: var(--font-lg); }

/* ========== Form Controls ========== */
label {
    display: block;
    margin-bottom: var(--space-2);
    font-size: var(--font-sm);
    font-weight: 500;
    color: var(--text);
}

input:not([type="checkbox"]):not([type="radio"]):not([type="submit"]):not([type="button"]),
textarea,
select {
    width: 100%;
    padding: 0.65rem 0.9rem;
    font-family: inherit;
    font-size: var(--font-base);
    color: var(--text);
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

input:focus-visible,
textarea:focus-visible,
select:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 15%, transparent);
}

input:disabled,
textarea:disabled,
select:disabled {
    background: var(--gray-100);
    opacity: 0.7;
    cursor: not-allowed;
}

input::placeholder,
textarea::placeholder {
    color: var(--muted);
}

textarea { resize: vertical; min-height: 120px; }

/* ========== Card Component ========== */
.card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-base), transform var(--transition-base);
}

.card:hover {
    box-shadow: var(--shadow-md);
}

.card-interactive {
    cursor: pointer;
}

.card-interactive:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
}

.card-header {
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--border);
}

.card-footer {
    padding-top: var(--space-4);
    margin-top: var(--space-4);
    border-top: 1px solid var(--border);
}

/* ========== Utility Classes ========== */
/* Text */
.text-center { text-align: center; }
.text-left   { text-align: left; }
.text-right  { text-align: right; }
.text-muted  { color: var(--muted); }
.text-primary { color: var(--primary); }
.text-accent  { color: var(--accent); }
.text-success { color: var(--success); }
.text-warning { color: var(--warning); }
.text-error   { color: var(--error); }

/* Font Weight */
.fw-medium { font-weight: 500; }
.fw-semibold { font-weight: 600; }
.fw-bold { font-weight: 700; }

/* Flex & Grid Helpers */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.items-center { align-items: center; }
.items-start { align-items: flex-start; }
.items-end { align-items: flex-end; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.justify-end { justify-content: flex-end; }

.gap-2 { gap: var(--space-2); }
.gap-4 { gap: var(--space-4); }
.gap-6 { gap: var(--space-6); }
.gap-8 { gap: var(--space-8); }

.stack { display: flex; flex-direction: column; gap: var(--space-4); }
.stack-sm { gap: var(--space-2); }
.stack-lg { gap: var(--space-8); }

/* Spacing */
.m-0 { margin: 0; }
.mt-4 { margin-top: var(--space-4); }
.mb-4 { margin-bottom: var(--space-4); }
.my-4 { margin-block: var(--space-4); }
.mx-auto { margin-inline: auto; }

.p-4 { padding: var(--space-4); }
.px-4 { padding-inline: var(--space-4); }
.py-4 { padding-block: var(--space-4); }

/* Width & Display */
.w-full { width: 100%; }
.hidden { display: none !important; }

/* ========== Responsive Grid ========== */
.grid { display: grid; gap: var(--space-6); }

@media (min-width: 640px) {
    .sm\:grid-2 { grid-template-columns: repeat(2, 1fr); }
}

@media (min-width: 768px) {
    .md\:grid-2 { grid-template-columns: repeat(2, 1fr); }
    .md\:grid-3 { grid-template-columns: repeat(3, 1fr); }
}

@media (min-width: 1024px) {
    .lg\:grid-3 { grid-template-columns: repeat(3, 1fr); }
    .lg\:grid-4 { grid-template-columns: repeat(4, 1fr); }
}

.grid-sidebar {
    grid-template-columns: 1fr 360px;
    gap: var(--space-8);
}

/* ========== Accessibility & Preferences ========== */
/* Skip Link */
.skip-link {
    position: absolute;
    top: -9999px;
    left: -9999px;
    background: var(--gray-900);
    color: var(--white);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius);
    z-index: var(--z-modal);
}

.skip-link:focus {
    top: var(--space-4);
    left: var(--space-4);
}

/* Screen Reader Only */
.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

/* Focus Visible */
:focus:not(:focus-visible) { outline: none; }
:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
}

/* Reduced Motion */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
    }
}

/* ========== Print Styles ========== */
@media print {
    *,
    *::before,
    *::after {
        background: transparent !important;
        color: #000 !important;
        box-shadow: none !important;
    }
    
    a::after {
        content: " (" attr(href) ")";
        font-size: 0.8em;
    }
    
    .no-print { display: none; }
}

/* ============================================
   LEGACY STYLES & THEME-SPECIFIC OVERRIDES
   ============================================ */
.related-articles,
.article-item,
.content-wrapper,

/* ============================================
   LEGACY STYLES & THEME-SPECIFIC OVERRIDES
   ============================================ */
h1 {
    font-size: clamp(2.5rem, 2vw + 1rem, 3.5rem);
    line-height: 1.1;
    margin-bottom: 0.5em;
}

h2 {
    font-size: clamp(2rem, 1.5vw + 0.5rem, 2.5rem);
    line-height: 1.2;
    margin-bottom: 0.5em;
}

h3 {
    font-size: clamp(1.5rem, 1vw + 0.5rem, 1.75rem);
    line-height: 1.3;
    margin-bottom: 0.5em;
}

h4 {
    font-size: clamp(1.25rem, 0.5vw + 0.5rem, 1.5rem);
    line-height: 1.4;
}

/* Enhanced button interactions */
button:hover,
.btn:hover {
    background: var(--accent-strong);
    box-shadow: 0 4px 12px var(--shadow-sm);
    transform: translateY(-1px);
}

button:focus,
.btn:focus {
    background: var(--accent-strong);
    box-shadow: 0 4px 12px var(--shadow-sm);
    outline: 3px solid var(--accent);
    outline-offset: 2px;
}

button:active,
.btn:active {
    transform: translateY(0);
    box-shadow: 0 2px 6px var(--shadow-sm);
}

/* Native aspect ratio support */
img[width][height] {
    height: auto;
    aspect-ratio: attr(width) / attr(height);
}

.video-wrapper iframe,
.video-wrapper video {
    aspect-ratio: 16 / 9;
}

.aspect-square {
    aspect-ratio: 1 / 1;
}

.aspect-video {
    aspect-ratio: 16 / 9;
}

.aspect-portrait {
    aspect-ratio: 3 / 4;
}

/* Enhanced focus indicators */
:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
}

:focus:not(:focus-visible) {
    outline: none;
}

a:focus-visible {
    outline-color: var(--accent-strong);
    text-decoration: underline;
}

/* ============================================
   HEADER STYLES
   ============================================ */
.top-bar {
    background: var(--primary);
    color: white;
    padding: 10px 0;
    font-size: 13px;
}

.top-bar .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.top-bar a {
    color: white;
    text-decoration: none;
    margin: 0 15px;
    transition: color 0.3s ease;
}

.top-bar a:hover {
    color: var(--accent-light);
}

.social-icons {
    display: flex;
    gap: 12px;
}

.social-icons a {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgb(255 255 255 / 10%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    margin: 0;
    transition: all 0.3s ease;
}

.social-icons a:hover {
    background: var(--secondary);
    transform: translateY(-2px);
}

header {
    background: white;
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: var(--shadow-sm);
}

.header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    display: flex;
    align-items: center;
}

.logo img,
.logo svg {
    height: 50px;
    width: auto;
}

nav ul {
    display: flex;
    list-style: none;
    gap: 30px;
}

nav a {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: color 0.3s ease;
    position: relative;
}

nav a::after {
    content: "";
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--secondary);
    transition: width 0.3s ease;
}

nav a:hover {
    color: var(--secondary);
}

nav a:hover::after {
    width: 100%;
}



/* ============================================
   SECTION HEADERS
   ============================================ */
.section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 30px;
}

.section-title {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Georgia, "Times New Roman", Times, serif;
    font-size: 28px;
    font-weight: 700;
    position: relative;
    padding-left: 15px;
}

.section-title::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 100%;
    background: var(--accent);
}

.view-all {
    color: var(--secondary);
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 5px;
    transition: gap 0.3s;
}

.view-all:hover {
    gap: 10px;
}

/* ============================================
   ANIMATED HERO BANNER
   ============================================ */
.hero-banner {
    position: relative;
    height: 60vh;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--gradient-hero);
    margin-bottom: 40px;
    cursor: pointer;
}

.hero-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--gradient-hero-bg);
    background-size: 200% 200%;
    animation: gradientShift 15s ease infinite;
    opacity: 0.9;
}

@keyframes gradientShift {
}

.hero-particles {
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.particle {
    position: absolute;
    background: rgb(255 255 255 / 10%);
    border-radius: 50%;
    animation: float 20s infinite ease-in-out;
}

.particle:nth-child(1) {
    width: 80px;
    height: 80px;
    left: 10%;
    top: 20%;
    animation-delay: 0s;
    animation-duration: 15s;
}

.particle:nth-child(2) {
    width: 60px;
    height: 60px;
    left: 70%;
    top: 40%;
    animation-delay: 2s;
    animation-duration: 18s;
}

.particle:nth-child(3) {
    width: 100px;
    height: 100px;
    left: 30%;
    top: 60%;
    animation-delay: 4s;
    animation-duration: 20s;
}

.particle:nth-child(4) {
    width: 40px;
    height: 40px;
    left: 85%;
    top: 15%;
    animation-delay: 1s;
    animation-duration: 16s;
}

.particle:nth-child(5) {
    width: 70px;
    height: 70px;
    left: 50%;
    top: 80%;
    animation-delay: 3s;
    animation-duration: 22s;
}

@keyframes float {
    25% {
        transform: translateY(-30px) translateX(20px) rotate(90deg);
        opacity: 0.5;
    }
    75% {
        transform: translateY(-30px) translateX(20px) rotate(270deg);
        opacity: 0.5;
    }
}

.hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: white;
    max-width: 800px;
    padding: 0 20px;
    animation: fadeInUp 1s ease-out;
    transition: transform 0.3s ease;
}

.hero-banner:hover .hero-content {
    transform: translateY(-5px);
}

@keyframes fadeInUp {
}


.hero-title .highlight {
    background: var(--secondary);
    padding: 5px 15px;
    border-radius: 8px;
    display: inline-block;
    box-shadow: 0 4px 15px rgb(45 106 79 / 40%);
    border: 2px solid #40916c;
}

@keyframes slideInLeft {
}

.hero-subtitle {
    font-size: clamp(0.9rem, 1.1vw, 1.5rem);
    margin: 0 0 30px;
    opacity: 0.95;
    font-weight: 300;
    animation: slideInRight 0.8s ease-out 0.2s both;
}

@keyframes slideInRight {
}

.hero-cta {
    display: inline-flex;
    gap: 15px;
    animation: fadeIn 0.8s ease-out 0.4s both;
}

@keyframes fadeIn {
}

.hero-button {
    padding: 15px 35px;
    font-size: 1.1rem;
    font-weight: 600;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
    position: relative;
    overflow: hidden;
}

.hero-button-primary {
    background: white;
    color: #667eea;
    box-shadow: 0 4px 15px rgb(0 0 0 / 20%);
}

.hero-button-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgb(0 0 0 / 30%);
}

.hero-button-secondary {
    background: transparent;
    color: white;
    border: 2px solid white;
}

.hero-button-secondary:hover {
    background: rgb(255 255 255 / 10%);
    transform: translateY(-2px);
}

.hero-button::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 40%);
    transform: translate(-50%, -50%);
    transition: width 0.3s ease-out, height 0.3s ease-out;
}

.hero-button:active::before {
    width: 200px;
    height: 200px;
    transition: width 0.5s ease-out, height 0.5s ease-out;
}

/* Trust badges */
.trust-badges {
    position: absolute;
    bottom: 10%;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 30px;
    align-items: center;
    z-index: 3;
}

.trust-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    color: white;
    font-size: 0.95rem;
    font-weight: 500;
    opacity: 0.9;
}

.badge-icon {
    font-size: 1.5rem;
}

/* Interactive effects */
.hero-banner:hover .particle {
    animation-play-state: paused;
}

.hero-banner::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgb(255 255 255 / 10%) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
}

.hero-banner:hover::after {
    opacity: 1;
}

/* Business growth effect on click */
.growth-indicator {
    position: absolute;
    font-size: 24px;
    font-weight: 700;
    color: var(--white);
    pointer-events: none;
    animation: growthRise 1s ease-out forwards;
    text-shadow: 0 2px 10px rgb(0 0 0 / 30%);
}

@keyframes growthRise {
    20% {
        opacity: 1;
    }
}

.shine-effect {
    position: absolute;
    width: 100px;
    height: 100px;
    background: radial-gradient(circle, rgb(255 255 255 / 80%) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
    animation: quickShine 0.4s ease-out forwards;
}

@keyframes quickShine {
    0% {
        transform: scale(0);
        opacity: 1;
    }
    100% {
        transform: scale(2);
        opacity: 0;
    }
}

.sparkle {
    position: absolute;
    width: 3px;
    height: 3px;
    background: var(--white);
    border-radius: 50%;
    pointer-events: none;
    box-shadow: 0 0 6px var(--white);
}

/* ============================================
   DON'T MISS SECTION - TABBED CONTENT
   ============================================ */
.dont-miss-section {
    margin: 40px auto;
    max-width: 1200px;
    padding: 0 20px;
}

.dont-miss-container {
    background: white;
    border-radius: 8px;
    overflow: visible;
    box-shadow: var(--shadow-md);
}

.category-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2px solid #f0f0f0;
    position: relative;
    overflow: visible;
    gap: 30px;
}

.dont-miss-label {
    background: var(--secondary);
    color: var(--white);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.5px;
    padding: 15px 28px;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
    border-radius: 8px 0 0;
}

.category-tabs {
    display: flex;
    overflow: auto visible;
    padding: 0 0 0 20px;
    gap: 0;
    justify-content: flex-end;
    margin-left: auto;
}

.category-tabs::-webkit-scrollbar {
    height: 0;
}

.tab-button {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 14px;
    font-weight: 500;
    padding: 18px 20px;
    cursor: pointer;
    transition: all 0.3s ease-in-out;
    border-bottom: 3px solid transparent;
    white-space: nowrap;
    position: relative;
    opacity: 1;
    max-width: 200px;
    transform-origin: left center;
}

.tab-button:hover {
    color: var(--secondary);
    background: rgb(45 106 79 / 5%);
}

.tab-button.active {
    color: var(--secondary);
    border-bottom-color: var(--secondary);
    background: rgb(45 106 79 / 8%);
}

/* More Dropdown */
.more-dropdown {
    position: relative;
    display: inline-block;
}

.more-dropdown .tab-button {
    display: flex;
    align-items: center;
    gap: 5px;
}

.more-dropdown.open .tab-button {
    color: var(--accent);
    border-bottom-color: var(--accent);
}

.dropdown-arrow {
    font-size: 10px;
    transition: transform 0.3s ease;
}

.more-dropdown.open .dropdown-arrow {
    transform: rotate(180deg);
}

.dropdown-menu {
    position: absolute;
    top: calc(100% + 3px);
    right: 0;
    background: white;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    box-shadow: var(--shadow-lg);
    min-width: 200px;
    max-height: 400px;
    overflow-y: auto;
    display: none;
    z-index: 9999;
}

.more-dropdown.open .dropdown-menu {
    display: block;
    animation: dropdownFadeIn 0.3s ease;
}

@keyframes dropdownFadeIn {
}

.dropdown-menu button {
    display: block;
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 14px 20px;
    color: var(--text-muted);
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s ease;
    border-left: 3px solid transparent;
}

.dropdown-menu button:first-child {
    border-radius: 8px 8px 0 0;
}

.dropdown-menu button:last-child {
    border-radius: 0 0 8px 8px;
}

.dropdown-menu button:hover {
    background: var(--light);
    color: var(--black);
    border-left-color: var(--secondary);
}

.dropdown-menu button.active {
    background: rgb(45 106 79 / 10%);
    color: var(--secondary);
    font-weight: 600;
    border-left-color: var(--secondary);
}

/* Content Area */
.content-wrapper {
    display: none;
    padding: 30px;
    animation: fadeIn 0.4s ease;
}

.content-wrapper.active {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 30px;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Featured Article */
.featured-article {
    position: relative;
}

.featured-image-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    aspect-ratio: 16 / 10.5;
    width: 100%;
}


.featured-article:hover .featured-image {
    transform: scale(1.05);
}

.category-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    background: var(--secondary);
    color: white;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 8px 14px;
    border-radius: 4px;
    z-index: 1;
}

.featured-content {
    margin-top: 20px;
}

.featured-title {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Georgia, "Times New Roman", Times, serif;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--black);
    margin-bottom: 12px;
    transition: color 0.3s ease;
    cursor: pointer;
}

.featured-article:hover .featured-title {
    color: var(--secondary);
}

.featured-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 12px;
}

.author {
    font-weight: 700;
    color: var(--black);
}

.featured-excerpt {
    color: var(--text-muted);
    line-height: 1.7;
    font-size: 15px;
}

.comment-count {
    background: var(--primary);
    color: white;
    font-size: 12px;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 15px;
}

/* Navigation Arrows */
.nav-arrows {
    display: flex;
    gap: 10px;
    margin-top: 20px;
}

.nav-arrow {
    width: 44px;
    height: 44px;
    border: 2px solid #e0e0e0;
    background: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: var(--text-muted);
    transition: all 0.3s ease;
    border-radius: 4px;
}

.nav-arrow:hover {
    background: var(--secondary);
    color: white;
    border-color: var(--secondary);
    transform: translateY(-2px);
}

/* Related Articles List */
.related-articles {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.article-item {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 15px;
    cursor: pointer;
    padding: 10px;
    border-radius: 8px;
    transition: all 0.3s ease;
}

.article-item:hover {
    background: var(--light);
}

.article-thumbnail {
    width: 120px;
    height: 90px;
    object-fit: cover;
    border-radius: 6px;
    transition: transform 0.3s ease;
}

.article-item:hover .article-thumbnail {
    transform: scale(1.05);
}

.article-info h3 {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--black);
    margin-bottom: 8px;
    transition: color 0.3s ease;
}

.article-item:hover .article-info h3 {
    color: var(--secondary);
}

.article-date {
    font-size: 13px;
    color: #999;
}

/* ============================================
   HERO SECTION - BREAKING NEWS SLIDER
   ============================================ */
.hero-section {
    padding: 40px 20px;
    max-width: 1200px;
    margin: 0 auto;
}

.hero-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 20px;
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-md);
}

.hero-main {
    position: relative;
    height: 500px;
    overflow: hidden;
}

.hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s ease;
}

.hero-slide.active {
    opacity: 1;
}

.hero-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 40px;
    background: var(--gradient-overlay-dark);
    color: white;
}

.hero-category {
    display: inline-block;
    background: var(--secondary);
    color: white;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 4px;
    margin-bottom: 15px;
}

.hero-title {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Georgia, "Times New Roman", Times, serif;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 10px;
}

.hero-meta {
    font-size: 14px;
    opacity: 0.8;
}

.hero-dots {
    position: absolute;
    bottom: 20px;
    right: 40px;
    display: flex;
    gap: 8px;
}

.hero-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgb(255 255 255 / 40%);
    cursor: pointer;
    transition: all 0.3s;
}

.hero-dot.active {
    background: var(--secondary);
    transform: scale(1.2);
}

.hero-sidebar {
    display: flex;
    flex-direction: column;
}

.hero-side-item {
    flex: 1;
    position: relative;
    overflow: hidden;
    cursor: pointer;
}

.hero-side-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
}

.hero-side-item:hover img {
    transform: scale(1.1);
}

.hero-side-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px;
    background: var(--gradient-overlay-medium);
    color: white;
}

.hero-side-title {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
}

/* ============================================
   TRENDING NOW - HORIZONTAL SCROLL
   ============================================ */
.trending-section {
    padding: 50px 20px;
    max-width: 1200px;
    margin: 0 auto;
}

.trending-container {
    background: white;
    border-radius: 12px;
    padding: 30px;
    box-shadow: var(--shadow-md);
}



.trending-scroll::-webkit-scrollbar {
    height: 6px;
}

.trending-scroll::-webkit-scrollbar-track {
    background: #f0f0f0;
    border-radius: 3px;
}

.trending-scroll::-webkit-scrollbar-thumb {
    background: var(--secondary);
    border-radius: 3px;
}

.trending-card {
    flex: 0 0 280px;
    scroll-snap-align: start;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s ease;
}

.trending-card:hover {
    transform: translateY(-5px);
}

.trending-number {
    position: absolute;
    top: 15px;
    left: 15px;
    width: 36px;
    height: 36px;
    background: var(--secondary);
    color: var(--white);
    font-size: 16px;
    font-weight: 700;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
}

.trending-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    transition: transform 0.5s ease;
}

.trending-card:hover img {
    transform: scale(1.1);
}

.trending-info {
    padding: 20px;
    background: var(--light);
}

.trending-category {
    color: var(--secondary);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 8px;
}

.trending-title {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--black);
    transition: color 0.3s;
}

.trending-card:hover .trending-title {
    color: var(--secondary);
}

/* ============================================
   CATEGORY GRID - 3 COLUMN LAYOUT
   ============================================ */
.category-grid-section {
    padding: 50px 20px;
    max-width: 1200px;
    margin: 0 auto;
}

.category-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
}

.category-column {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-md);
}

.category-column-header {
    padding: 18px 25px;
    border-bottom: 3px solid;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.category-column:nth-child(1) .category-column-header {
    border-color: #e74c3c;
}

.category-column:nth-child(2) .category-column-header {
    border-color: #3498db;
}

.category-column:nth-child(3) .category-column-header {
    border-color: #27ae60;
}

.category-column-title {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Georgia, "Times New Roman", Times, serif;
    font-size: 20px;
    font-weight: 700;
}

.category-column-header a {
    color: var(--gray);
    font-size: 13px;
    text-decoration: none;
    font-weight: 500;
}

.category-column-header a:hover {
    color: var(--secondary);
}

.category-featured {
    position: relative;
    overflow: hidden;
}

.category-featured img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    transition: transform 0.5s ease;
}

.category-column:hover .category-featured img {
    transform: scale(1.05);
}

.category-featured-content {
    padding: 20px;
}

.category-featured-title {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 10px;
    cursor: pointer;
    transition: color 0.3s;
}

.category-featured-title:hover {
    color: var(--secondary);
}

.category-featured-date {
    font-size: 13px;
    color: var(--gray);
}


.category-list-item {
    padding: 15px 0;
    border-bottom: 1px solid #f0f0f0;
    display: flex;
    gap: 15px;
    cursor: pointer;
    transition: padding-left 0.3s;
}

.category-list-item:last-child {
    border-bottom: none;
}

.category-list-number {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    background: #f0f0f0;
    color: var(--gray);
    font-size: 13px;
    font-weight: 700;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.category-list-item:hover .category-list-number {
    background: var(--secondary);
    color: var(--white);
}

.category-list-title {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
    color: #333;
    transition: color 0.3s;
}

.category-list-item:hover .category-list-title {
    color: var(--secondary);
}

/* ============================================
   VIDEO SECTION - DARK THEME
   ============================================ */
.video-section {
    background: var(--primary);
    padding: 60px 20px;
    margin: 50px 0;
}

.video-section .section-title {
    color: white;
}

.video-section .section-title::before {
    background: var(--secondary);
}

.video-section .view-all {
    color: var(--accent);
}

.video-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 25px;
    margin-top: 30px;
}

.video-main {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
}

.video-main img {
    width: 100%;
    height: 400px;
    object-fit: cover;
    transition: transform 0.5s ease;
}

.video-main:hover img {
    transform: scale(1.05);
}

.video-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80px;
    height: 80px;
    background: var(--secondary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}

.video-play-btn::before {
    content: "";
    border-style: solid;
    border-width: 12px 0 12px 20px;
    border-color: transparent transparent transparent white;
    margin-left: 5px;
}

.video-main:hover .video-play-btn {
    transform: translate(-50%, -50%) scale(1.1);
    background: var(--accent);
}

.video-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 30px;
    background: var(--gradient-overlay-dark);
    color: white;
}

.video-duration {
    display: inline-block;
    background: var(--secondary);
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 10px;
}

.video-title {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Georgia, "Times New Roman", Times, serif;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.3;
}

.video-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.video-item {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 15px;
    background: rgb(255 255 255 / 5%);
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    transition: background 0.3s;
}

.video-item:hover {
    background: rgb(255 255 255 / 10%);
}

.video-item-thumb {
    position: relative;
    height: 90px;
}

.video-item-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.video-item-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 36px;
    height: 36px;
    background: rgb(0 0 0 / 70%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.video-item-play::before {
    content: "";
    border-style: solid;
    border-width: 6px 0 6px 10px;
    border-color: transparent transparent transparent white;
    margin-left: 2px;
}

.video-item-info {
    padding: 12px 15px 12px 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.video-item-duration {
    color: var(--accent);
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 5px;
}

.video-item-title {
    color: white;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    transition: color 0.3s;
}

.video-item:hover .video-item-title {
    color: var(--accent);
}

/* ============================================
   OPINION SECTION - CARDS WITH AVATARS
   ============================================ */
.opinion-section {
    padding: 50px 20px;
    max-width: 1200px;
    margin: 0 auto;
}

.opinion-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 25px;
}

.opinion-card {
    background: white;
    border-radius: 12px;
    padding: 30px;
    box-shadow: var(--shadow-md);
    position: relative;
    transition: transform 0.3s ease;
}

.opinion-card:hover {
    transform: translateY(-5px);
}

.opinion-card::before {
    content: '"';
    position: absolute;
    top: 20px;
    right: 25px;
    font-family: Georgia, serif;
    font-size: 80px;
    color: #f0f0f0;
    line-height: 1;
}

.opinion-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 20px;
    border: 3px solid var(--secondary);
}

.opinion-quote {
    font-size: 15px;
    line-height: 1.7;
    color: #444;
    margin-bottom: 20px;
    position: relative;
    z-index: 1;
}

.opinion-author {
    font-weight: 700;
    color: var(--black);
    font-size: 14px;
}

.opinion-role {
    color: var(--gray);
    font-size: 13px;
    margin-top: 3px;
}

/* ============================================
   NEWSLETTER SECTION
   ============================================ */
.newsletter-section {
    background: var(--gradient-1);
    padding: 60px 20px;
    margin: 50px 0;
}

.newsletter-container {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
    color: white;
}

.newsletter-title {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Georgia, "Times New Roman", Times, serif;
    font-size: 36px;
    font-weight: 700;
    margin-bottom: 15px;
}

.newsletter-text {
    font-size: 16px;
    opacity: 0.9;
    margin-bottom: 30px;
}

.newsletter-form {
    display: flex;
    gap: 12px;
    max-width: 500px;
    margin: 0 auto;
}

.newsletter-input {
    flex: 1;
    padding: 16px 24px;
    border: none;
    border-radius: 50px;
    font-size: 15px;
    outline: none;
}

.newsletter-btn {
    padding: 16px 32px;
    background: var(--white);
    color: var(--primary);
    border: none;
    border-radius: 50px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
}

.newsletter-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 20px rgb(0 0 0 / 20%);
    background: var(--accent-light);
    color: var(--white);
}

/* Newsletter inline feedback */
.newsletter-feedback {
    font-size: 14px;
    padding: 8px 12px;
    border-radius: 6px;
    margin-top: 8px;
    display: inline-block;
    transition: opacity 220ms ease, transform 220ms ease;
}

.newsletter-feedback.success {
    background-color: #e6ffed;
    color: #064e2c;
    border: 1px solid #b7f0c6;
}

.newsletter-feedback.error {
    background-color: #fff1f0;
    color: #7a1f1f;
    border: 1px solid #f3c0c0;
}

/* ============================================
   FOOTER
   ============================================ */
footer {
    background: var(--primary);
    color: white;
    padding: 60px 20px 30px;
}

.footer-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 40px;
    margin-bottom: 40px;
}

.footer-brand .logo {
    margin-bottom: 20px;
}

.footer-brand .logo img {
    height: 45px;
    width: auto;
    filter: brightness(0) invert(1);
    opacity: 0.9;
}

.footer-brand p {
    color: rgb(255 255 255 / 70%);
    font-size: 14px;
    line-height: 1.7;
    margin-bottom: 20px;
}

.footer-social {
    display: flex;
    gap: 12px;
}

.footer-social a {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgb(255 255 255 / 10%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    text-decoration: none;
    transition: all 0.3s;
}

.footer-social a:hover {
    background: var(--secondary);
    color: var(--white);
}

.footer-column h4 {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 20px;
    position: relative;
    padding-bottom: 10px;
}

.footer-column h4::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 30px;
    height: 2px;
    background: var(--secondary);
}

.footer-column ul {
    list-style: none;
}

.footer-column li {
    margin-bottom: 12px;
}

.footer-column a {
    color: rgb(255 255 255 / 70%);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.3s;
}

.footer-column a:hover {
    color: var(--accent-light);
}

.footer-bottom {
    max-width: 1200px;
    margin: 0 auto;
    padding-top: 30px;
    border-top: 1px solid rgb(255 255 255 / 10%);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    color: rgb(255 255 255 / 60%);
}

.footer-links a {
    color: rgb(255 255 255 / 60%);
    text-decoration: none;
    margin-left: 20px;
    transition: color 0.3s;
}

.footer-links a:hover {
    color: var(--accent-light);
}

/* ============================================
   PAGE HEADER & MAIN CONTENT
   ============================================ */
.page-header {
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    padding: 60px 0;
    color: white;
    text-align: center;
}

.page-title {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Georgia, "Times New Roman", Times, serif;
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 15px;
}

.page-subtitle {
    font-size: 1.25rem;
    opacity: 0.9;
}

.main-content {
    padding: 50px 0;
}

.content-grid {
    display: grid;
    grid-template-columns: 280px 1fr 350px;
    gap: 40px;
}

/* ============================================
   WIDGETS & CATEGORIES LAYOUT
   ============================================ */
.widgets-categories-section {
    max-width: 1200px;
    margin: 40px auto;
    padding: 0 20px;
}

.widgets-categories-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 30px;
}

.left-content {
    display: flex;
    flex-direction: column;
    gap: 30px;
}

.right-sidebar {
    display: flex;
    flex-direction: column;
    gap: 25px;
}

/* Trending Box */
.trending-box {
    background: white;
    border-radius: 12px;
    padding: 25px;
    box-shadow: 0 2px 10px rgb(0 0 0 / 10%);
}

.trending-box-title {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Georgia, "Times New Roman", Times, serif;
    font-size: 24px;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 20px;
}

.trending-box .trending-scroll {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    padding: 10px 0;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
}

.trending-box .trending-scroll::-webkit-scrollbar {
    height: 6px;
}

.trending-box .trending-scroll::-webkit-scrollbar-track {
    background: #f0f0f0;
    border-radius: 3px;
}

.trending-box .trending-scroll::-webkit-scrollbar-thumb {
    background: var(--secondary);
    border-radius: 3px;
}

.trending-box .trending-card {
    flex: 0 0 220px;
    scroll-snap-align: start;
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s ease;
}

.trending-box .trending-card:hover {
    transform: translateY(-3px);
}

.trending-box .trending-number {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 30px;
    height: 30px;
    background: var(--secondary);
    color: var(--white);
    font-size: 14px;
    font-weight: 700;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
}

.trending-box .trending-card img {
    width: 100%;
    height: 140px;
    object-fit: cover;
    transition: transform 0.5s ease;
}

.trending-box .trending-card:hover img {
    transform: scale(1.1);
}

.trending-box .trending-info {
    padding: 12px;
    background: var(--light);
}

.trending-box .trending-category {
    color: var(--secondary);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 6px;
}

.trending-box .trending-title {
    font-size: 13px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--primary);
    transition: color 0.3s;
}

.trending-box .trending-card:hover .trending-title {
    color: var(--secondary);
}

/* Category boxes */
.category-box {
    background: var(--light);
    padding: 25px;
    border-radius: 12px;
}

.category-box-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 15px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--secondary);
}

.category-box-list {
    list-style: none;
}

.category-box-item {
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
}

.category-box-item:last-child {
    border-bottom: none;
}

.category-box-link {
    text-decoration: none;
    color: var(--text-dark);
    font-size: 14px;
    font-weight: 500;
    transition: color 0.3s;
    display: block;
}

.category-box-link:hover {
    color: var(--secondary);
}

/* Category Boxes Grid (2 columns) */
.category-boxes-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
}

.category-box-dontmiss {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 10px rgb(0 0 0 / 10%);
}

.category-box-dontmiss .featured-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
}

.category-box-dontmiss .featured-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
}

.category-box-dontmiss:hover .featured-image {
    transform: scale(1.05);
}

.category-box-dontmiss .category-badge {
    position: absolute;
    top: 15px;
    left: 15px;
    background: var(--secondary);
    color: white;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
}

.category-box-dontmiss .featured-content {
    padding: 20px;
}

.category-box-dontmiss .featured-title {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Georgia, "Times New Roman", Times, serif;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 12px;
}

.category-box-dontmiss .featured-title a {
    color: var(--primary);
    text-decoration: none;
    transition: color 0.3s;
}

.category-box-dontmiss .featured-title a:hover {
    color: var(--secondary);
}

.category-box-dontmiss .featured-meta {
    display: flex;
    gap: 10px;
    color: var(--gray);
    font-size: 13px;
    margin-bottom: 12px;
}

.category-box-dontmiss .featured-excerpt {
    color: var(--text-dark);
    line-height: 1.6;
    font-size: 14px;
    margin-bottom: 15px;
}

.category-box-dontmiss .related-articles {
    border-top: 1px solid var(--border);
    padding-top: 15px;
}

.category-box-dontmiss .article-item {
    display: flex;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    transition: background 0.3s;
    cursor: pointer;
}

.category-box-dontmiss .article-item:last-child {
    border-bottom: none;
}

.category-box-dontmiss .article-item:hover {
    background: var(--light);
}

.category-box-dontmiss .article-thumbnail {
    width: 80px;
    height: 60px;
    object-fit: cover;
    border-radius: 6px;
    flex-shrink: 0;
}

.category-box-dontmiss .article-info h3 {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--primary);
    margin-bottom: 4px;
    transition: color 0.3s;
}

.category-box-dontmiss .article-item:hover .article-info h3 {
    color: var(--secondary);
}

.category-box-dontmiss .article-date {
    font-size: 12px;
    color: #999;
}

/* Other Blog Posts Sidebar */
.other-posts-sidebar {
    background: var(--light);
    padding: 25px;
    border-radius: 12px;
}

.other-posts-sidebar .widget-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--secondary);
}

.other-posts-list {
    list-style: none;
}

.other-post-item {
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
}

.other-post-item:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
}

.other-post-link {
    text-decoration: none;
    color: var(--text-dark);
}

.other-post-category {
    display: inline-block;
    background: var(--secondary);
    color: white;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 8px;
}

.other-post-title {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 8px;
    transition: color 0.3s;
}

.other-post-link:hover .other-post-title {
    color: var(--secondary);
}

.other-post-meta {
    font-size: 12px;
    color: var(--gray);
}

/* ============================================
   BLOG GRID
   ============================================ */
.blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
}

.blog-card {
    display: flex;
    flex-direction: column;
    background: white;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s;
    height: 100%;
}

.blog-card:hover {
    box-shadow: 0 10px 30px rgb(0 0 0 / 10%);
    transform: translateY(-5px);
}

.blog-card-image {
    width: 100%;
    height: 220px;
    object-fit: cover;
}

.blog-card-content {
    padding: 25px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.blog-card-category {
    display: inline-block;
    background: var(--secondary);
    color: white;
    padding: 5px 14px;
    border-radius: 15px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 15px;
}

.blog-card-title {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Georgia, "Times New Roman", Times, serif;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 12px;
}

.blog-card-title a {
    color: var(--primary);
    text-decoration: none;
    transition: color 0.3s;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.blog-card-title a:hover {
    color: var(--secondary);
}

.blog-card-excerpt {
    color: var(--text-light);
    margin-bottom: 15px;
    line-height: 1.6;
    font-size: 0.95rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
}

.blog-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 13px;
    color: var(--text-light);
    margin-bottom: 15px;
}

.blog-card-meta-item {
    display: flex;
    align-items: center;
    gap: 5px;
}

.blog-card-footer {
    margin-top: auto;
    padding-top: 15px;
    border-top: 1px solid var(--border);
}

.read-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--secondary);
    font-weight: 600;
    text-decoration: none;
    transition: gap 0.3s;
}

.read-more:hover {
    gap: 12px;
}

/* Pagination */
.pagination {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 60px;
}

.pagination a,
.pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 45px;
    height: 45px;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-dark);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s;
}

.pagination a:hover {
    background: var(--secondary);
    color: white;
    border-color: var(--secondary);
}

.pagination .active {
    background: var(--secondary);
    color: white;
    border-color: var(--secondary);
}

/* ============================================
   SIDEBAR
   ============================================ */
.sidebar {
    position: sticky;
    top: 100px;
    align-self: start;
}

.sidebar-widget {
    background: var(--light);
    padding: 30px;
    border-radius: 12px;
    margin-bottom: 30px;
}

.widget-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 2px solid var(--secondary);
}

.search-form {
    display: flex;
    gap: 10px;
}

.search-input {
    flex: 1;
    padding: 12px 15px;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 14px;
}

.search-btn {
    padding: 12px 20px;
    background: var(--secondary);
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
    transition: background 0.3s;
}

.search-btn:hover {
    background: var(--accent);
}

.category-list {
    list-style: none;
}

.category-item {
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
}

.category-item:last-child {
    border-bottom: none;
}

.category-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
    color: var(--text-dark);
    font-weight: 500;
    transition: color 0.3s;
}

.category-link:hover {
    color: var(--secondary);
}

.category-count {
    background: var(--secondary);
    color: white;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 12px;
}

.popular-posts {
    list-style: none;
}

.popular-post {
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
}

.popular-post:last-child {
    border-bottom: none;
}

.popular-post-link {
    display: flex;
    gap: 15px;
    text-decoration: none;
    color: var(--text-dark);
}

.popular-post-thumb {
    width: 70px;
    height: 70px;
    object-fit: cover;
    border-radius: 6px;
    flex-shrink: 0;
}

.popular-post-info h4 {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 5px;
    line-height: 1.4;
}

.popular-post-date {
    font-size: 12px;
    color: var(--text-light);
}

.tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.tag {
    display: inline-block;
    background: white;
    color: var(--text-dark);
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 13px;
    text-decoration: none;
    border: 1px solid var(--border);
    transition: all 0.3s;
}

.tag:hover {
    background: var(--secondary);
    color: white;
    border-color: var(--secondary);
}

/* ============================================
   BREADCRUMB
   ============================================ */
.breadcrumb {
    background: var(--light);
    padding: 15px 0;
    font-size: 14px;
}

.breadcrumb a {
    color: var(--secondary);
    text-decoration: none;
}

.breadcrumb a:hover {
    text-decoration: underline;
}

.breadcrumb span {
    color: var(--gray);
    margin: 0 8px;
}

/* ============================================
   BLOG POST
   ============================================ */
.post-header {
    margin-bottom: 30px;
}

.post-category {
    display: inline-block;
    background: var(--secondary);
    color: white;
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 15px;
}

.post-title {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Georgia, "Times New Roman", Times, serif;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--primary);
    margin-bottom: 20px;
}

.post-meta {
    display: flex;
    align-items: center;
    gap: 20px;
    color: var(--text-light);
    font-size: 14px;
    margin-bottom: 30px;
}

.post-meta-item {
    display: flex;
    align-items: center;
    gap: 8px;
}

.author-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 600;
}

.featured-image {
    width: 100%;
    height: 450px;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: 40px;
}

/* Affiliate Disclosure */
.affiliate-disclosure {
    background: #fff3cd;
    border-left: 4px solid #ffc107;
    padding: 20px 25px;
    margin-bottom: 40px;
    border-radius: 8px;
    font-size: 14px;
    line-height: 1.6;
}

.affiliate-disclosure strong {
    display: block;
    margin-bottom: 8px;
    color: #856404;
}

/* Post Content */
.post-content {
    font-size: 18px;
    line-height: 1.8;
}

.post-content h2 {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Georgia, "Times New Roman", Times, serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--primary);
    margin: 40px 0 20px;
}

.post-content h3 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--primary);
    margin: 30px 0 15px;
}

.post-content p {
    margin-bottom: 25px;
}

.post-content ul,
.post-content ol {
    margin: 25px 0;
    padding-left: 30px;
}

.post-content li {
    margin-bottom: 12px;
}

.post-content a {
    color: var(--secondary);
    font-weight: 600;
    text-decoration: underline;
    transition: color 0.3s;
}

.post-content a:hover {
    color: var(--accent);
}

.post-content blockquote {
    border-left: 4px solid var(--secondary);
    padding-left: 25px;
    margin: 30px 0;
    font-style: italic;
    color: var(--text-light);
    background: var(--light);
    padding: 20px 25px;
    border-radius: 0 8px 8px 0;
}

/* Comparison Table */
.comparison-table-wrapper {
    margin: 40px 0;
    overflow-x: auto;
}

.comparison-table {
    width: 100%;
    border-collapse: collapse;
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgb(0 0 0 / 8%);
}

.comparison-table thead {
    background: var(--primary);
    color: white;
}

.comparison-table th {
    padding: 18px 15px;
    text-align: left;
    font-weight: 600;
    font-size: 15px;
}

.comparison-table td {
    padding: 18px 15px;
    border-bottom: 1px solid var(--border);
}

.comparison-table tr:last-child td {
    border-bottom: none;
}

.comparison-table tbody tr:hover {
    background: var(--light);
}

.provider-name {
    font-weight: 600;
    color: var(--primary);
    font-size: 16px;
}

.price-cell {
    font-weight: 700;
    color: var(--secondary);
    font-size: 18px;
}

.rating {
    color: #ffc107;
    font-size: 16px;
}

.table-cta {
    padding: 10px 20px;
    background: var(--secondary);
    color: white;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    display: inline-block;
    transition: all 0.3s;
    cursor: pointer;
}

.table-cta:hover {
    background: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgb(45 106 79 / 30%);
}

/* Provider Card */
.provider-card {
    background: white;
    border: 2px solid var(--border);
    border-radius: 12px;
    padding: 35px;
    margin: 40px 0;
    box-shadow: 0 4px 20px rgb(0 0 0 / 8%);
    transition: all 0.3s ease;
}

.provider-card:hover {
    box-shadow: 0 8px 30px rgb(0 0 0 / 12%);
    transform: translateY(-2px);
}

.provider-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 25px;
    padding-bottom: 25px;
    border-bottom: 2px solid #f5f5f5;
}

.provider-info h3 {
    font-size: 1.75rem;
    color: var(--secondary);
    margin-bottom: 10px;
}

.provider-tagline {
    color: var(--text-muted);
    font-size: 16px;
}

.provider-price {
    text-align: right;
}

.price-label {
    font-size: 14px;
    color: var(--text-muted);
    display: block;
    margin-bottom: 5px;
}

.price-amount {
    font-size: 2.2rem;
    font-weight: 700;
    color: #40916c;
    line-height: 1;
}

.price-period {
    font-size: 16px;
    color: var(--text-muted);
}

.provider-rating {
    margin-bottom: 25px;
}

.stars {
    color: #ffc107;
    font-size: 20px;
    margin-right: 10px;
}

.rating-text {
    color: var(--text-muted);
    font-size: 15px;
}

.provider-description {
    margin-bottom: 25px;
    line-height: 1.7;
}

/* Best For Badge */
.best-for {
    display: inline-block;
    background: var(--gradient-hero);
    color: white;
    padding: 8px 18px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 20px;
    animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% {
        opacity: 1;
    }
    50% {
        opacity: 0.85;
    }
}

/* Quick Summary Box */
.summary-box {
    background: var(--gradient-2);
    color: white;
    padding: 35px;
    border-radius: 12px;
    margin: 40px 0;
}

.summary-box h3 {
    color: white;
    margin-bottom: 20px;
    font-size: 1.5rem;
}

.summary-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.summary-item {
    text-align: center;
}

.summary-item-title {
    font-size: 14px;
    opacity: 0.9;
    margin-bottom: 8px;
}

.summary-item-value {
    font-size: 1.5rem;
    font-weight: 700;
}

/* Features Grid */
.features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
    margin-bottom: 25px;
}

.feature-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    background: #f5f5f5;
    border-radius: 6px;
}

.feature-icon {
    color: #40916c;
    font-size: 18px;
}

/* Pros and Cons */
.pros-cons {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 30px;
}

.pros,

.pros {
    background: #d4edda;
    border: 1px solid #c3e6cb;
}

.cons {
    background: #f8d7da;
    border: 1px solid #f5c6cb;
}

.pros h4 {
    color: #155724;
    margin-bottom: 12px;
    font-size: 16px;
}

.cons h4 {
    color: #721c24;
    margin-bottom: 12px;
    font-size: 16px;
}

.pros ul,
.cons ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.pros li {
    color: #155724;
    padding: 6px 0;
    font-size: 14px;
}

.cons li {
    color: #721c24;
    padding: 6px 0;
    font-size: 14px;
}

.pros li::before {
    content: "âœ“ ";
    font-weight: 700;
    margin-right: 8px;
}

.cons li::before {
    content: "âœ— ";
    font-weight: 700;
    margin-right: 8px;
}

/* CTA Buttons */
.cta-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.cta-primary {
    flex: 1;
    padding: 16px 32px;
    background: #40916c;
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
    text-align: center;
    transition: all 0.3s;
    cursor: pointer;
    display: inline-block;
    min-width: 200px;
}

.cta-primary:hover {
    background: var(--secondary);
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgb(45 106 79 / 30%);
}

.cta-secondary {
    padding: 16px 32px;
    background: white;
    color: #40916c;
    border: 2px solid #40916c;
    border-radius: 8px;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    text-align: center;
    transition: all 0.3s;
    cursor: pointer;
    display: inline-block;
}

.cta-secondary:hover {
    background: #f5f5f5;
}

/* Top Pick Widget */
.top-pick {
    background: linear-gradient(135deg, #40916c 0%, #52b788 100%);
    color: white;
    padding: 25px;
    border-radius: 12px;
    text-align: center;
}

.top-pick h4 {
    color: white;
    margin-bottom: 15px;
    font-size: 1.1rem;
}

.top-pick-name {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 10px;
}

.top-pick-price {
    font-size: 1.25rem;
    margin-bottom: 20px;
    opacity: 0.95;
}

.top-pick-btn {
    display: block;
    padding: 14px;
    background: white;
    color: #40916c;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    transition: all 0.3s;
}

.top-pick-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgb(0 0 0 / 20%);
}

/* Trending Scroll Cursor */
.trending-scroll {
    cursor: grab;
    user-select: none;
}

.trending-scroll:active {
    cursor: grabbing;
}

/* ============================================
   404 ERROR PAGE STYLES
   ============================================ */
.error-404-page {
    padding: 80px 0;
    text-align: center;
}

.error-404-title {
    font-size: 120px;
    color: var(--secondary);
    margin: 0;
}

.error-404-content h2 {
    font-size: 36px;
    margin: 20px 0;
}

.error-404-search {
    margin: 40px auto;
    max-width: 600px;
}

.btn-primary {
    display: inline-block;
    background: var(--secondary);
    color: white;
    padding: 15px 40px;
    border-radius: 8px;
    text-decoration: none;
    margin: 20px 0 40px;
}

.error-404-suggestions {
    margin-top: 60px;
}

/* ============================================
   RESPONSIVE DESIGN (MOBILE-FIRST)
   ============================================ */

/* Base (0 - 639px) - Already mobile-first */

/* SM (640px+) */
@media (width >= 640px) {
    .container {
        max-width: 640px;
        padding-left: 20px;
        padding-right: 20px;
    }
}

/* MD (768px+) */
@media (width >= 768px) {
    .container {
        max-width: 768px;
        padding-left: 24px;
        padding-right: 24px;
    }

    .hero-sidebar {
        flex-direction: column;
        height: auto;
    }

    .content-wrapper.active {
        grid-template-columns: 1fr;
        gap: 30px;
        padding: 20px 15px;
    }

    .category-grid {
        grid-template-columns: 1fr;
        gap: 25px;
    }

    .video-grid {
        grid-template-columns: 1fr;
    }

    .opinion-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .footer-grid {
        grid-template-columns: 1fr;
        gap: 30px;
        text-align: center;
    }

    .hero-main {
        height: 350px;
    }

    .hero-title {
        font-size: 24px;
    }

    .hero-side-item {
        height: 150px;
    }

    .category-header {
        gap: 15px;
    }


    .category-tabs {
        padding: 0 0 0 10px;
    }



    .widgets-grid-container {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .trending-box {
        grid-column: span 2;
    }

    .category-boxes-grid {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .newsletter-form {
        flex-direction: column;
    }

    .footer-column h4::after {
        left: 50%;
        transform: translateX(-50%);
    }

    .footer-social,
    .footer-brand .logo {
        justify-content: center;
    }

    .footer-bottom {
        flex-direction: column;
        gap: 15px;
        text-align: center;
    }

    .footer-links a {
        margin: 0 10px;
    }

    .logo {
        font-size: 28px;
    }



    .newsletter-title {
        font-size: 28px;
    }


    .blog-grid {
        grid-template-columns: 1fr;
        gap: 30px;
    }




    .other-posts-sidebar {
        display: none;
    }

    .features-grid {
        grid-template-columns: 1fr;
    }

    .summary-grid {
        grid-template-columns: 1fr;
        gap: 15px;
    }

    .mobile-menu-btn {
        display: block;
    }

    .page-title {
        font-size: 2.2rem;
    }

    .content-grid {
        grid-template-columns: 1fr;
        gap: 40px;
    }

    .sidebar {
        position: static;
    }


    .article-item {
        grid-template-columns: 100px 1fr;
        gap: 12px;
    }

    .article-thumbnail {
        width: 100px;
        height: 75px;
    }

    .article-info h3 {
        font-size: 14px;
    }


    .pagination a,

    .top-bar .container {
        flex-direction: column;
        gap: 10px;
        text-align: center;
    }

    .top-bar-links a {
        margin: 0 10px;
    }

    .page-subtitle {
        font-size: 1rem;
    }

    .dont-miss-label {
        font-size: 11px;
        padding: 12px 16px;
    }

    .tab-button {
        padding: 12px 15px;
        font-size: 12px;
    }

    .featured-title {
        font-size: 18px;
    }

    .featured-image-wrapper {
        aspect-ratio: 16 / 11;
    }

    .section-title {
        font-size: 26px;
    }

    .trending-card {
        flex: 0 0 220px;
    }

    .trending-number {
        width: 32px;
        height: 32px;
        font-size: 14px;
    }

    .trending-card img {
        height: 160px;
    }

    .trending-info {
        padding: 15px;
    }

    .trending-title {
        font-size: 14px;
    }

    .blog-card-title {
        font-size: 1.25rem;
    }

    .blog-card-image {
        height: 200px;
    }

    .blog-card-content {
        padding: 20px;
    }

    .blog-card-meta {
        font-size: 12px;
        gap: 10px;
    }

    .sidebar-widget {
        padding: 20px;
    }

    .pagination {
        gap: 5px;
    }

    .pagination a,
    .pagination span {
        width: 40px;
        height: 40px;
        font-size: 14px;
    }
}

/* LG (1024px+) */
@media (width >= 1024px) {
    .container {
        max-width: 1024px;
        padding-left: 32px;
        padding-right: 32px;
    }

    .hero-sidebar {
        flex-direction: column;
        height: auto;
    }

    .category-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
    }

    .opinion-grid {
        grid-template-columns: repeat(4, 1fr);
    }

    .footer-grid {
        grid-template-columns: 2fr repeat(3, 1fr);
    }

    .hero-main {
        height: 500px;
    }

    .hero-title {
        font-size: 32px;
    }

    .hero-side-item {
        height: auto;
    }

    .category-header {
        gap: 30px;
    }

    .dont-miss-label {
        padding: 15px 28px;
        font-size: 13px;
    }

    .category-tabs {
        padding: 0 0 0 20px;
    }

    .tab-button {
        padding: 18px 20px;
        font-size: 14px;
    }

    .content-wrapper.active {
        grid-template-columns: 1fr 380px;
        gap: 30px;
        padding: 30px;
    }

    .featured-title {
        font-size: 28px;
    }

    .widgets-grid-container {
        grid-template-columns: 2fr 1fr;
        gap: 30px;
    }

    .trending-box {
        grid-column: auto;
    }

    .category-boxes-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 30px;
    }

    .newsletter-form {
        flex-direction: row;
    }

    .footer-column h4::after {
        left: 0;
        transform: none;
    }

    .footer-social,
    .footer-brand .logo {
        justify-content: flex-start;
    }

    .footer-bottom {
        flex-direction: row;
        gap: 0;
        text-align: left;
    }

    .footer-links a {
        margin-left: 20px;
    }

    .logo {
        font-size: initial;
    }
}
